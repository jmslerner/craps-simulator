{
  "name": "bubble-craps-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "Practice electronic bubble craps (crapless and traditional) with a live coach and a 3D dice dome.",
  "type": "module",
  "engines": {
    "node": "^24.13.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project core --project ui --project physics",
    "test:watch": "vitest --project core --project ui --project physics",
    "test:slow": "vitest run --project slow",
    "e2e": "playwright test",
    "verify": "tsc -b && eslint . && npm test && vite build && node scripts/check-bundle.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.19.3",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
